bindsym $mod+Return exec $terminal
bindsym $mod+F exec firefox
bindsym $mod+E exec ski
bindsym $mod+BackSpace scratchpad show
bindsym $mod+Q kill
bindsym $mod+Shift+F floating toggle

bindsym XF86MonBrightnessDown exec wayshell brightness lower
bindsym XF86MonBrightnessUp exec wayshell brightness raise

bindsym Print exec wayshell screenshot
bindsym Shift+Print exec wayshell screenshot --edit
bindsym $mod+Print exec wayshell screenshot --full
bindsym $mod+Shift+Print exec wayshell screenshot --full --edit

bindsym XF86PowerOff exec wayshell lock
bindsym $mod+L exec wayshell lock

bindsym $mod+space exec playerctl play-pause
bindsym XF86AudioPause exec playerctl play-pause
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioPrev exec playerctl previous
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioMicMute exec wayshell volume mic-toggle
bindsym XF86AudioMute exec wayshell volume mute-toggle
bindsym XF86AudioLowerVolume exec wayshell volume lower
bindsym XF86AudioRaiseVolume exec wayshell volume raise

bindsym $mod+R exec wayshell reload
bindsym $mod+C exec wayshell msg toggle clipboard
bindsym $mod+D exec wayshell msg toggle launcher
bindsym $mod+M exec wayshell msg toggle music
bindsym $mod+B exec wayshell msg toggle system
bindsym $mod+W exec wayshell msg toggle wallpaper
bindsym $mod+S exec wayshell msg toggle calendar
bindsym $mod+N exec wayshell msg toggle network
bindsym $mod+V exec wayshell msg toggle volume
bindsym $mod+H exec wayshell msg toggle settings
bindsym $mod+A exec wayshell msg bar autohide

bindsym $mod+Left focus left
bindsym $mod+Right focus right
bindsym $mod+Up workspace prev
bindsym $mod+Down workspace next

bindsym $mod+Ctrl+Left move left
bindsym $mod+Ctrl+Right move right
bindsym $mod+Ctrl+Up move container to workspace prev; workspace prev
bindsym $mod+Ctrl+Down move container to workspace next; workspace next

bindsym $mod+Shift+Left resize shrink width 5 ppt
bindsym $mod+Shift+Right resize grow width 5 ppt
bindsym $mod+Shift+Up resize shrink height 5 ppt
bindsym $mod+Shift+Down resize grow height 5 ppt

bindsym $mod+1 exec wayshell msg workspace 1
bindsym $mod+2 exec wayshell msg workspace 2
bindsym $mod+3 exec wayshell msg workspace 3
bindsym $mod+4 exec wayshell msg workspace 4
bindsym $mod+5 exec wayshell msg workspace 5
bindsym $mod+6 exec wayshell msg workspace 6
bindsym $mod+7 exec wayshell msg workspace 7
bindsym $mod+8 exec wayshell msg workspace 8
bindsym $mod+9 exec wayshell msg workspace 9
bindsym $mod+0 exec wayshell msg workspace 10

bindsym $mod+Shift+1 exec wayshell msg workspace 1 move
bindsym $mod+Shift+2 exec wayshell msg workspace 2 move
bindsym $mod+Shift+3 exec wayshell msg workspace 3 move
bindsym $mod+Shift+4 exec wayshell msg workspace 4 move
bindsym $mod+Shift+5 exec wayshell msg workspace 5 move
bindsym $mod+Shift+6 exec wayshell msg workspace 6 move
bindsym $mod+Shift+7 exec wayshell msg workspace 7 move
bindsym $mod+Shift+8 exec wayshell msg workspace 8 move
bindsym $mod+Shift+9 exec wayshell msg workspace 9 move
bindsym $mod+Shift+0 exec wayshell msg workspace 10 move
