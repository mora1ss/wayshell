{
  "name": "Rofi",
  "category": "tools",
  "icon": "󰍉",
  "detect": {
    "bin": [
      "rofi"
    ]
  },
  "templates": [
    {
      "input": "wayshell.rasi",
      "output": "$XDG_DATA_HOME/rofi/themes/wayshell.rasi"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": "$XDG_CONFIG_HOME/rofi/config.rasi",
      "line": "@theme \"wayshell\"",
      "comment": "//",
      "disable": "^\\s*@theme\\s",
      "create": true
    }
  ]
}
