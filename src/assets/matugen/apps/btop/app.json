{
  "name": "Btop",
  "category": "tools",
  "icon": "󰄪",
  "detect": {
    "bin": [
      "btop"
    ]
  },
  "templates": [
    {
      "input": "wayshell.theme",
      "output": "$XDG_CONFIG_HOME/btop/themes/wayshell.theme"
    }
  ],
  "integrate": [
    {
      "type": "ini",
      "file": "$XDG_CONFIG_HOME/btop/btop.conf",
      "sep": " = ",
      "values": {
        "": {
          "color_theme": "\"wayshell\""
        }
      },
      "create": true
    }
  ],
  "reload": [
    "pkill -USR2 -x btop; true"
  ]
}
