{
  "name": "Superfile",
  "category": "tools",
  "icon": "󰉋",
  "hint": "restart",
  "detect": {
    "bin": [
      "spf",
      "superfile"
    ]
  },
  "templates": [
    {
      "input": "wayshell.toml",
      "output": "$XDG_CONFIG_HOME/superfile/theme/wayshell.toml"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": "$XDG_CONFIG_HOME/superfile/config.toml",
      "section": "",
      "line": "theme = \"wayshell\"",
      "disable": "^\\s*theme\\s*="
    }
  ]
}
