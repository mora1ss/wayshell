{
  "name": "Yazi",
  "category": "tools",
  "icon": "󰇥",
  "hint": "restart",
  "detect": {
    "bin": [
      "yazi"
    ]
  },
  "templates": [
    {
      "input": "flavor.toml",
      "output": "$XDG_CONFIG_HOME/yazi/flavors/wayshell.yazi/flavor.toml"
    },
    {
      "input": "tmtheme.xml",
      "output": "$XDG_CONFIG_HOME/yazi/flavors/wayshell.yazi/tmtheme.xml"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": "$XDG_CONFIG_HOME/yazi/theme.toml",
      "section": "flavor",
      "line": [
        "dark = \"wayshell\"",
        "light = \"wayshell\""
      ],
      "disable": "^\\s*(dark|light)\\s*=",
      "create": true
    }
  ]
}
