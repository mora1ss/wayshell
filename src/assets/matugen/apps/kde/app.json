{
  "name": "KDE apps",
  "category": "system",
  "icon": "󰣇",
  "hint": "restart",
  "detect": {
    "bin": [
      "dolphin",
      "kate",
      "kwrite",
      "okular",
      "gwenview",
      "ark",
      "kdenlive",
      "krita",
      "konsole",
      "plasmashell"
    ]
  },
  "templates": [
    {
      "input": "Wayshell.colors",
      "output": "$XDG_DATA_HOME/color-schemes/Wayshell.colors"
    }
  ],
  "integrate": [
    {
      "type": "ini",
      "file": "$XDG_CONFIG_HOME/kdeglobals",
      "values_from": "$XDG_DATA_HOME/color-schemes/Wayshell.colors",
      "sections": "^(Colors:|ColorEffects:|WM$)",
      "values": {
        "General": {
          "ColorScheme": "Wayshell"
        }
      },
      "create": true
    }
  ]
}
