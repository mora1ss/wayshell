{
  "name": "Glow",
  "category": "tools",
  "icon": "",
  "detect": {
    "bin": [
      "glow"
    ]
  },
  "templates": [
    {
      "input": "wayshell.json",
      "output": "$XDG_CONFIG_HOME/glow/wayshell.json"
    }
  ],
  "integrate": [
    {
      "type": "line",
      "file": "$XDG_CONFIG_HOME/glow/glow.yml",
      "line": "style: \"$XDG_CONFIG_HOME/glow/wayshell.json\"",
      "disable": "^\\s*style\\s*:",
      "create": true
    }
  ]
}
